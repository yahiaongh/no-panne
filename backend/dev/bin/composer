#!/bin/bash
# Run Composer inside the no-panne-php Docker image.
# Usage: dev/bin/composer [composer-args...]
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
TTY_FLAG=""
if [ -t 1 ]; then TTY_FLAG="-t"; fi
exec docker run --rm -i $TTY_FLAG \
  -v "$REPO_ROOT:/app" -w /app/backend --network no-panne \
  no-panne-php composer "$@"